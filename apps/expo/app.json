{
  "expo": {
    "name": "DMP",
    "slug": "dmp",
    "scheme": "dmp",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.dynpar.dmp",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.dynpar.dmp",
      "config": {
        "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
      }
    },
    "plugins": [
      "./plugins/withBuildFixes",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cecd00c6-824f-4639-87d3-416c07dc85c7"
      }
    },
    "owner": "martin.espinola"
  }
}
